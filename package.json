{
  "name": "all-things-mcp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @all-things-mcp/web dev",
    "dev:web": "pnpm --filter @all-things-mcp/web dev",
    "dev:runtime": "pnpm --filter @all-things-mcp/guide-runtime dev",
    "dev:demo": "pnpm --parallel --filter @all-things-mcp/guide-runtime --filter @all-things-mcp/web dev",
    "demo:verify": "pnpm --filter @all-things-mcp/guide-runtime demo:verify",
    "build": "pnpm --filter @all-things-mcp/web build",
    "start": "pnpm --filter @all-things-mcp/web start",
    "lint": "pnpm --filter @all-things-mcp/web lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "pnpm --filter @all-things-mcp/web format",
    "format:write": "pnpm --filter @all-things-mcp/web format:write",
    "content:validate": "pnpm --filter @all-things-mcp/web content:validate",
    "brand:generate": "pnpm --filter @all-things-mcp/web brand:generate",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @all-things-mcp/web test:e2e",
    "check": "pnpm --filter @all-things-mcp/web check"
  },
  "devDependencies": {
    "supabase": "^2.116.0"
  }
}
