PORT=8787
GUIDE_RUNTIME_SHARED_SECRET=replace-with-the-same-32-character-secret-used-by-web
GUIDE_RUNTIME_PUBLIC_URL=http://localhost:8787
REAL_MCP_GUIDES=building-your-first-mcp-server
# Number of trusted reverse proxies in front of the runtime. Leave 0 unless you
# operate them; otherwise X-Forwarded-For is client-controlled and ignored.
TRUSTED_PROXY_COUNT=0
MCP_REQUESTS_PER_IP_MINUTE=30
MCP_REQUESTS_PER_WORKSPACE_HOUR=120
MCP_UPSTREAM_DAILY_LIMIT=8000
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
# Use the Supabase pooler connection string in deployed environments.
DATABASE_URL=postgresql://postgres.project-ref:password@pooler.supabase.com:6543/postgres
