NEXT_PUBLIC_SITE_URL=https://www.allthingsmcp.com
NEXT_PUBLIC_GITHUB_REPO=https://github.com/allthingsmcp/allthingsmcp
NEXT_PUBLIC_SUBSTACK_URL=https://allthingsmcp.substack.com
NEXT_PUBLIC_SUBSTACK_EMBED_URL=https://allthingsmcp.substack.com/embed

# Supabase Auth. Configure the GitHub provider in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_ENABLED=false
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Guide Runtime
GUIDE_RUNTIME_URL=http://localhost:8787
GUIDE_RUNTIME_SHARED_SECRET=replace-with-the-same-32-character-secret-used-by-runtime

# First-party analytics (/admin/analytics). Server-only: never prefix with NEXT_PUBLIC_.
# Supabase secret (service role) key, used only by the collector and the dashboard.
SUPABASE_SECRET_KEY=
# Random string of 32+ characters for the daily visitor hash. Changing it resets visitor counts.
ANALYTICS_SECRET=
# Comma-separated GitHub account emails allowed to open /admin/analytics.
ANALYTICS_ADMIN_EMAILS=
# Hostnames that may record events. Defaults to allthingsmcp.com,www.allthingsmcp.com.
# ANALYTICS_HOSTNAMES=localhost
# Collection runs on production deployments only. Set to true to test it locally.
# ANALYTICS_ENABLED=true
