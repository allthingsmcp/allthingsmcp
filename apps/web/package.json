{
  "name": "@all-things-mcp/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.2.0 <25"
  },
  "scripts": {
    "postinstall": "fumadocs-mdx source.config.ts .source",
    "dev": "node scripts/dev.mjs --disable-source-maps",
    "dev:debug": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "fumadocs-mdx source.config.ts .source && tsc --noEmit",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "content:validate": "node --import tsx scripts/validate-content.ts",
    "brand:generate": "node --import tsx scripts/generate-brand-assets.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:memory": "node --test scripts/check-memory.test.mjs && node scripts/check-memory.mjs",
    "check": "pnpm format && pnpm lint && pnpm typecheck && pnpm content:validate && pnpm test && pnpm build"
  },
  "dependencies": {
    "@all-things-mcp/contracts": "workspace:*",
    "@all-things-mcp/mcp-templates": "workspace:*",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@types/mdx": "^2.0.13",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "^16.18.0",
    "fumadocs-mdx": "^15.5.0",
    "gray-matter": "^4.0.3",
    "jose": "^6.2.15",
    "lucide-react": "^1.69.0",
    "next": "^16.4.5",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.4.5",
    "fast-glob": "^3.3.3",
    "jsdom": "^27.2.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.0.13"
  }
}
